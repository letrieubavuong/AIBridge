<Window x:Class="AIBridge.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:AIBridge.ViewModels"
        xmlns:models="clr-namespace:AIBridge.Models"
        xmlns:infra="clr-namespace:AIBridge.Infrastructure"
        mc:Ignorable="d"
        Title="AIBridge — Trợ lý điều phối phát triển phần mềm" 
        Height="800" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <infra:InverseBooleanConverter x:Key="InverseBool" />

        <SolidColorBrush x:Key="BgBrush" Color="#1E1E2E" />
        <SolidColorBrush x:Key="CardBrush" Color="#282A36" />
        <SolidColorBrush x:Key="BorderBrush" Color="#44475A" />
        <SolidColorBrush x:Key="TextBrush" Color="#F8F8F2" />
        <SolidColorBrush x:Key="SubTextBrush" Color="#6272A4" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#BD93F9" />
        <SolidColorBrush x:Key="AccentBrush" Color="#50FA7B" />
        <SolidColorBrush x:Key="WarningBrush" Color="#FFB86C" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#FF5555" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar (fixed 200px) -->
            <ColumnDefinition Width="200" />
            <!-- Right Content Area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0" Background="#181824" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <!-- Header -->
                    <RowDefinition Height="Auto" />
                    <!-- Navigation Menu -->
                    <RowDefinition Height="*" />
                    <!-- Footer / Settings -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="4,8,4,24">
                    <TextBlock Text="AIBridge" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                    <TextBlock Text="Trợ lý điều phối AI" FontSize="11" Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Navigation List -->
                <StackPanel Grid.Row="1">
                    <!-- Nav 1: Tổng quan -->
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Overview" 
                            HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊 " FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="Tổng quan" FontWeight="SemiBold" FontSize="13"/>
                        </StackPanel>
                    </Button>

                    <!-- Nav 2: Dự án -->
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Project" 
                            HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁 " FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="Dự án" FontWeight="SemiBold" FontSize="13"/>
                        </StackPanel>
                    </Button>

                    <!-- Nav 3: Thực thi -->
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Execution" 
                            HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡ " FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="Thực thi" FontWeight="SemiBold" FontSize="13"/>
                        </StackPanel>
                    </Button>

                    <!-- Nav 4: Kết nối -->
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Connection" 
                            HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌐 " FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="Kết nối" FontWeight="SemiBold" FontSize="13"/>
                        </StackPanel>
                    </Button>

                    <!-- Nav 5: Nhật ký -->
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Logs" 
                            HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋 " FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="Nhật ký" FontWeight="SemiBold" FontSize="13"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Footer: Cài đặt -->
                <Button Grid.Row="2" Command="{Binding NavigateCommand}" CommandParameter="Settings" 
                        HorizontalContentAlignment="Left" Padding="12,10" Margin="0,8,0,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙️ " FontSize="14" Margin="0,0,8,0"/>
                        <TextBlock Text="Cài đặt" FontWeight="SemiBold" FontSize="13"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- RIGHT CONTENT AREA -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Grid Margin="24">

                <!-- ================================================== -->
                <!-- 1. TRANG TỔNG QUAN (OVERVIEW PAGE) -->
                <!-- ================================================== -->
                <Grid Visibility="{Binding IsOverviewSelected, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <!-- Header -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20,16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="AIBridge" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                                    <TextBlock Text="Trợ lý điều phối phát triển phần mềm" FontSize="13" Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0" />
                                </StackPanel>

                                <Border Grid.Column="1" Background="#1E1E2E" Padding="14,8" CornerRadius="6" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SystemStatusText}" FontSize="15" FontWeight="Bold" Foreground="{Binding SystemStatusColor}" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 4 Status Cards -->
                        <UniformGrid Columns="4" Margin="0,0,0,16">
                            <!-- ChatGPT Card -->
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="CHATGPT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SubTextBrush}" />
                                    <TextBlock Text="{Binding ChatGptStatusVietnamese}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Antigravity Card -->
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="4,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="ANTIGRAVITY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SubTextBrush}" />
                                    <TextBlock Text="{Binding AntigravityStatusVietnamese}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Git Card -->
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="4,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="GIT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SubTextBrush}" />
                                    <TextBlock Text="{Binding GitStatusVietnamese}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Project Card -->
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="DỰ ÁN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SubTextBrush}" />
                                    <TextBlock Text="{Binding ProjectNameDisplay}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Progress Bars Card -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20,16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="TIẾN ĐỘ DỰ ÁN" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8" />
                                <ProgressBar Value="{Binding ProjectPercent}" Height="12" Foreground="{StaticResource AccentBrush}" Background="#1E1E2E" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding ProjectProgressText}" FontSize="12" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,16" />

                                <TextBlock Text="TIẾN ĐỘ GIAI ĐOẠN" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8" />
                                <ProgressBar Value="{Binding PhasePercent}" Height="12" Foreground="{StaticResource PrimaryBrush}" Background="#1E1E2E" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding PhaseProgressText}" FontSize="12" Foreground="{StaticResource SubTextBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- PROMINENT NEXT ACTION CARD -->
                        <Border Background="#2B2D42" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="8" Padding="24,20">
                            <StackPanel>
                                <TextBlock Text="VIỆC CẦN LÀM TIẾP THEO" FontSize="12" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding NextActionText}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,14" />

                                <WrapPanel>
                                    <Button Content="Chuyển đến Dự án" Command="{Binding NavigateCommand}" CommandParameter="Project" 
                                            Visibility="{Binding IsProjectSelected, Converter={StaticResource InverseBool}}"
                                            Background="{StaticResource PrimaryBrush}" Foreground="#1E1E2E" FontWeight="Bold" Padding="14,8" Margin="0,0,10,0" />
                                    <Button Content="Chuyển đến Thực thi" Command="{Binding NavigateCommand}" CommandParameter="Execution" 
                                            Background="{StaticResource AccentBrush}" Foreground="#1E1E2E" FontWeight="Bold" Padding="14,8" Margin="0,0,10,0" />
                                    <Button Content="Bật MCP cục bộ" Command="{Binding StartMcpCommand}" 
                                            Visibility="{Binding IsMcpRunning, Converter={StaticResource InverseBool}}"
                                            Background="{StaticResource AccentBrush}" Foreground="#1E1E2E" FontWeight="Bold" Padding="14,8" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ================================================== -->
                <!-- 2. TRANG DỰ ÁN (PROJECT PAGE) -->
                <!-- ================================================== -->
                <Grid Visibility="{Binding IsProjectSelected, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="DỰ ÁN" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,16" />

                        <!-- Project Details Info Card -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20,16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Tên dự án -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Tên dự án:" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,10" />
                                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding PlanningProjectNameText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                                <!-- Mô tả / Yêu cầu -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Mô tả / Yêu cầu:" VerticalAlignment="Top" Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,10" />
                                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding PlanningIdeaText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Margin="0,0,0,10" />

                                <!-- Thư mục dự án -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Thư mục dự án:" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding WorkspacePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" />
                                <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal">
                                    <Button Content="Chọn thư mục" Command="{Binding BrowseWorkspaceCommand}" Padding="12,6" Margin="0,0,10,0" />
                                    <Border Background="#1E1E2E" Padding="10,6" CornerRadius="4">
                                        <TextBlock Text="{Binding WorkspaceStatusVietnamese}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Project Plan Section -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="KẾ HOẠCH DỰ ÁN" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Tạo kế hoạch" Command="{Binding GeneratePlanCommand}" Background="{StaticResource PrimaryBrush}" Foreground="#1E1E2E" FontWeight="Bold" Margin="0,0,8,0" />
                                        <Button Content="Phê duyệt kế hoạch" Command="{Binding ApprovePlanCommand}" Visibility="{Binding IsPlanApprovable, Converter={StaticResource BoolToVis}}" Background="{StaticResource AccentBrush}" Foreground="#1E1E2E" FontWeight="Bold" Margin="0,0,8,0" />
                                        <Button Content="Yêu cầu chỉnh sửa" Command="{Binding RevisePlanCommand}" Visibility="{Binding HasPlanAvailable, Converter={StaticResource BoolToVis}}" Margin="0,0,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Grid MinHeight="300">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="280" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Plan Tree View -->
                                    <Border Grid.Column="0" Background="#1E1E2E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,12,0">
                                        <TreeView ItemsSource="{Binding CurrentProjectPlan.Phases}">
                                            <TreeView.ItemTemplate>
                                                <HierarchicalDataTemplate ItemsSource="{Binding Tasks}">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="2,4" />
                                                    <HierarchicalDataTemplate.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource SubTextBrush}" Margin="2,2" />
                                                        </DataTemplate>
                                                    </HierarchicalDataTemplate.ItemTemplate>
                                                </HierarchicalDataTemplate>
                                            </TreeView.ItemTemplate>
                                        </TreeView>
                                    </Border>

                                    <!-- Right Detail Panel -->
                                    <Border Grid.Column="1" Background="#1E1E2E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="CHI TIẾT CÔNG VIỆC" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10" />
                                            <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                                <TextBlock Text="{Binding SelectedNodeDetailsText}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextBrush}" />
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ================================================== -->
                <!-- 3. TRANG THỰC THI (EXECUTION PAGE) -->
                <!-- ================================================== -->
                <Grid Visibility="{Binding IsExecutionSelected, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="THỰC THI CÔNG VIỆC" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,16" />

                        <!-- Current Task Card -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20,16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="CÔNG VIỆC HIỆN TẠI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SubTextBrush}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="Mã công việc: " Foreground="{StaticResource SubTextBrush}" />
                                        <TextBlock Text="{Binding CurrentTaskId}" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,16,0" />
                                        <TextBlock Text="Trạng thái: " Foreground="{StaticResource SubTextBrush}" />
                                        <TextBlock Text="{Binding ExecutionStatusDisplay}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Chuẩn bị Prompt" Command="{Binding GeneratePromptCommand}" Margin="0,0,8,0" />
                                    <Button Content="Gửi Antigravity" Command="{Binding DispatchTaskCommand}" Background="{StaticResource PrimaryBrush}" Foreground="#1E1E2E" FontWeight="Bold" Margin="0,0,8,0" />
                                    <Button Content="Hủy bỏ" Command="{Binding CancelExecutionCommand}" Visibility="{Binding IsTaskRunning, Converter={StaticResource BoolToVis}}" Background="{StaticResource ErrorBrush}" Foreground="White" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Prompt Preview Section -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20,16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="NỘI DUNG GỬI ANTIGRAVITY" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8" />
                                <TextBox Text="{Binding PromptPreviewText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="180" FontFamily="Consolas" FontSize="12" />
                            </StackPanel>
                        </Border>

                        <!-- Human Approval Section -->
                        <Border Background="#2C243B" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="8" Padding="20,16" Margin="0,0,0,16"
                                Visibility="{Binding IsHumanApprovalRequired, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="QUYỀN THỰC THI" FontSize="12" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" />
                                    <TextBlock Text="⚠ Công việc này cần sự cho phép của bạn trước khi chạy." FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,4,0,0" />
                                </StackPanel>

                                <Button Grid.Column="1" Content="CHO PHÉP THỰC THI" Command="{Binding ApproveExecutionCommand}" 
                                        Background="{StaticResource AccentBrush}" Foreground="#1E1E2E" FontWeight="Bold" FontSize="14" Padding="20,10" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Git Changes Evidence Section -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="THAY ĐỔI GIT BẰNG CHỨNG" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,6" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Commit: " Foreground="{StaticResource SubTextBrush}" />
                                        <TextBlock Text="{Binding LastTaskCommitText}" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,16,0" />
                                        <TextBlock Text="File thay đổi: " Foreground="{StaticResource SubTextBrush}" />
                                        <TextBlock Text="{Binding LastTaskChangedFilesText}" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Xem bằng chứng Git" Command="{Binding ViewEvidenceCommand}" Margin="0,0,8,0" />
                                    <Button Content="Đẩy Git lên Remote" Command="{Binding PushGitCommand}" Background="{StaticResource AccentBrush}" Foreground="#1E1E2E" FontWeight="Bold" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ================================================== -->
                <!-- 4. TRANG KẾT NỐI (CONNECTION PAGE) -->
                <!-- ================================================== -->
                <Grid Visibility="{Binding IsConnectionSelected, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="KẾT NỐI CHATGPT WEB &amp; MCP" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,16" />

                        <!-- 1. Card: MCP Server cục bộ -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20,16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="MCP Server (Cục bộ)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="Trạng thái: " Foreground="{StaticResource SubTextBrush}" FontSize="13" />
                                        <TextBlock Text="{Binding ChatGptStatusVietnamese}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="Địa chỉ: " Foreground="{StaticResource SubTextBrush}" FontSize="12" />
                                        <TextBlock Text="{Binding McpEndpointText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource SubTextBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="BẬT MCP" Command="{Binding StartMcpCommand}" Visibility="{Binding IsMcpRunning, Converter={StaticResource InverseBool}}" 
                                            Background="{StaticResource AccentBrush}" Foreground="#1E1E2E" FontWeight="Bold" FontSize="13" Padding="14,6" Margin="0,0,8,0" />
                                    <Button Content="TẮT MCP" Command="{Binding StopMcpCommand}" Visibility="{Binding IsMcpRunning, Converter={StaticResource BoolToVis}}" 
                                            Background="{StaticResource ErrorBrush}" Foreground="White" FontWeight="Bold" FontSize="13" Padding="14,6" Margin="0,0,8,0" />
                                    <Button Content="Kiểm tra MCP" Command="{Binding RunMcpSelfTestCommand}" FontSize="13" Padding="12,6" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 2. Card: Cloudflare Tunnel Public HTTPS -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20,16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Kết nối Internet (Cloudflare Tunnel HTTPS)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="Trạng thái Tunnel: " Foreground="{StaticResource SubTextBrush}" FontSize="13" />
                                        <TextBlock Text="{Binding TunnelStatusText}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="Địa chỉ công khai (Public Endpoint): " Foreground="{StaticResource SubTextBrush}" FontSize="12" />
                                        <TextBlock Text="{Binding PublicMcpEndpointText, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Thiết lập kết nối ChatGPT" Command="{Binding StartTunnelCommand}" Visibility="{Binding IsTunnelRunning, Converter={StaticResource InverseBool}}"
                                            Background="{StaticResource AccentBrush}" Foreground="#1E1E2E" FontWeight="Bold" FontSize="13" Padding="14,6" Margin="0,0,8,0" />
                                    <Button Content="Ngắt Tunnel" Command="{Binding StopTunnelCommand}" Visibility="{Binding IsTunnelRunning, Converter={StaticResource BoolToVis}}"
                                            Background="{StaticResource ErrorBrush}" Foreground="White" FontWeight="Bold" FontSize="13" Padding="14,6" Margin="0,0,8,0" />
                                    <Button Content="Sao chép địa chỉ" Command="{Binding CopyPublicEndpointCommand}" FontSize="13" Padding="12,6" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 3. Card: Self-Test Result Summary -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="TỰ KIỂM TRA MCP (MCP SELF-TEST)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                                    <TextBlock Text="{Binding SelfTestStatusText}" FontSize="13" Foreground="{StaticResource TextBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Chạy Self-Test" Command="{Binding RunMcpSelfTestCommand}" VerticalAlignment="Center" Padding="12,6" />
                            </Grid>
                        </Border>

                        <!-- 4. Advanced Technical Details Card -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Expander Header="THÔNG TIN KỸ THUẬT (NÂNG CAO)" Background="{StaticResource CardBrush}" Foreground="{StaticResource SubTextBrush}" FontWeight="Bold">
                            <StackPanel Margin="0,12,0,0">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Địa chỉ MCP Cục bộ:" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding McpEndpointText, Mode=OneWay}" IsReadOnly="True" />
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Local Bridge Server:" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding BridgeHostPortText, Mode=OneWay}" IsReadOnly="True" />
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Cloudflare Tunnel Version:" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding TunnelVersionText, Mode=OneWay}" IsReadOnly="True" />
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Mã Token xác thực:" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding DisplayedApiTokenText, Mode=OneWay}" IsReadOnly="True" Margin="0,0,8,0" />
                                    <WrapPanel Grid.Column="2">
                                        <Button Content="Ẩn/Hiện" Command="{Binding ToggleTokenMaskCommand}" Padding="8,4" Margin="0,0,4,0" />
                                        <Button Content="Sao chép Token" Command="{Binding CopyTokenCommand}" Padding="8,4" Margin="0,0,4,0" />
                                        <Button Content="Tạo Token mới" Command="{Binding RegenerateTokenCommand}" Padding="8,4" />
                                    </WrapPanel>
                                </Grid>
                            </StackPanel>
                        </Expander>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ================================================== -->
                <!-- 5. TRANG NHẬT KÝ (LOGS PAGE) -->
                <!-- ================================================== -->
                <Grid Visibility="{Binding IsLogsSelected, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="NHẬT KÝ HOẠT ĐỘNG" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Sao chép nhật ký" Command="{Binding CopyLogsCommand}" Margin="0,0,8,0" />
                                <Button Content="Xóa hiển thị" Command="{Binding ClearLogViewCommand}" />
                            </StackPanel>
                        </Grid>

                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding LogEntries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" Foreground="{StaticResource SubTextBrush}" FontFamily="Consolas" FontSize="11" />
                                                <TextBlock Grid.Column="1" Text="{Binding LogLevel}" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" FontSize="11" />
                                                <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ================================================== -->
                <!-- 6. TRANG CÀI ĐẶT (SETTINGS PAGE) -->
                <!-- ================================================== -->
                <Grid Visibility="{Binding IsSettingsSelected, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="CÀI ĐẶT HỆ THỐNG" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,16" />

                        <!-- Section 1: Antigravity Settings -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20,16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="ANTIGRAVITY CLI" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Đường dẫn:" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding AntigravityPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                    <Button Grid.Column="2" Content="Chọn..." Command="{Binding BrowseAntigravityCommand}" Padding="10,4" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="Trạng thái: " Foreground="{StaticResource SubTextBrush}" Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding AntigravityStatusVietnamese}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,16,0" />

                                    <TextBlock Text="Phiên bản: " Foreground="{StaticResource SubTextBrush}" Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding CliVersionText}" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,16,0" />

                                    <TextBlock Text="Xác thực: " Foreground="{StaticResource SubTextBrush}" Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding AuthStateText}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                </StackPanel>

                                <WrapPanel>
                                    <Button Content="Kiểm tra" Command="{Binding TestAntigravityCommand}" Margin="0,0,8,0" />
                                    <Button Content="Cài đặt CLI" Command="{Binding InstallCliCommand}" Visibility="{Binding IsCliMissing, Converter={StaticResource BoolToVis}}" Background="{StaticResource WarningBrush}" Foreground="#1E1E2E" FontWeight="Bold" Margin="0,0,8,0" />
                                    <Button Content="Đăng nhập" Command="{Binding AuthenticateCommand}" Visibility="{Binding IsAuthRequired, Converter={StaticResource BoolToVis}}" Background="{StaticResource PrimaryBrush}" Foreground="#1E1E2E" FontWeight="Bold" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Section 2: Git Settings -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20,16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="GIT / GITHUB" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="Git Version: " Foreground="{StaticResource SubTextBrush}" Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding GitVersionText}" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,16,0" />

                                    <TextBlock Text="Repository: " Foreground="{StaticResource SubTextBrush}" Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding GitRepoText}" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,16,0" />

                                    <TextBlock Text="Branch: " Foreground="{StaticResource SubTextBrush}" Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding GitBranchText}" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                </StackPanel>

                                <Button Content="Làm mới trạng thái Git" Command="{Binding RefreshGitCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <!-- Section 3: Optional Internal Brain Settings -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20,16">
                            <StackPanel>
                                <TextBlock Text="AI NỘI BỘ (TÙY CHỌN)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="Không cần thiết khi sử dụng ChatGPT Web làm bộ điều phối." FontSize="12" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,12" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Nhà cung cấp AI:" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding BrainProviders}" SelectedItem="{Binding SelectedBrainProvider}" DisplayMemberPath="DisplayName" />
                                </Grid>

                                <Button Content="Thử nghiệm AI nội bộ" Command="{Binding TestBrainCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
